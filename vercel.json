{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "quizapp_backend": {
      "root": "QuizApp_Backend",
      "framework": "express"
    },
    "quizapp_frontend": {
      "root": "QuizApp_Frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "quizapp_backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "quizapp_frontend"
      }
    }
  ]
}
