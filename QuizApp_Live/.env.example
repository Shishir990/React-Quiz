# Same database as QuizApp_Backend
MONGO_URI=mongodb+srv://...

# Shared with QuizApp_Backend: it signs the one-minute tickets this server accepts.
# Use a long random string, different from JWT_SECRET.
LIVE_TICKET_SECRET=change-me

# The site's address(es), comma separated, allowed to connect (production)
LIVE_CORS_ORIGINS=https://your-app.vercel.app

PORT=8090
